# Copy to /opt/laggente/secrets/application.env on the server.
# This file is injected only into the API container.
# Keep the destination owned by root:laggente with mode 0640.

APP_ENV=production
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BASE_DOMAIN=laggente.com
APP_ORIGIN=https://app.laggente.com
CORS_ORIGINS=https://app.laggente.com
TRUSTED_HOSTS=laggente.com,*.laggente.com
COOKIE_SECURE=true
SESSION_TTL_SECONDS=1209600
MAGIC_LINK_TTL_SECONDS=900
INVITATION_TTL_SECONDS=604800

# Keep pilot_password for the seeded operator until magic-link login is tested. Professional
# invitations still require the transactional email settings below.
AUTH_MODE=pilot_password
PILOT_EMAIL=REPLACE_WITH_MAURO_EMAIL
PILOT_PASSWORD=REPLACE_WITH_AT_LEAST_14_RANDOM_CHARACTERS
PILOT_NAME=Mauro Rossi
SEED_DEMO=true
AUTO_CREATE_SCHEMA=false

# Backend-owned market emphasis. Higher weights appear first on the brand surface and guide the
# Studio, but never override a tenant's active profession or configuration.
PRODUCT_POSITIONING_JSON={"audience":"Professionisti che lavorano attraverso relazioni, competenza e fiducia, a partire dagli agenti immobiliari.","opening_question":"Che lavoro fai?","featured_verticals":[{"id":"real_estate_it","label":"Agenti immobiliari","weight":100,"status":"pilot","template_id":"seller_it_v1","example_answer":"Sono un agente immobiliare a Roma Nord. Prima di valutare un immobile controllo titolo di provenienza, conformità urbanistica e catastale, APE, occupazione e vincoli.","headline":"Partiamo dagli agenti immobiliari.","description":"Il primo settore reso concreto dal pilot italiano, senza trasformare la conversazione in una pipeline."}]}

OPENAI_API_KEY=REPLACE_WITH_PROJECT_KEY
OPENAI_MODEL=gpt-5.6
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_MAX_TURNS=6

# Required for professional invitations and for AUTH_MODE=magic_link. Invited passwordless
# professionals continue to use magic-link login even while the seeded operator uses a password.
RESEND_API_KEY=
FROM_EMAIL=LAGGENTE <accesso@laggente.com>

# Agent-native professional email is inactive until Resend DNS and the receiving webhook are ready.
AGENT_MAIL_ENABLED=false
AGENT_MAIL_PROVIDER=resend
AGENT_MAIL_FROM_DOMAIN=laggente.com
AGENT_MAIL_REPLY_DOMAIN=aldioprena.resend.app
RESEND_WEBHOOK_SECRET=
AGENT_MAIL_MAX_INBOUND_BYTES=5242880

# Promotional outreach is a separate, consent-qualified capability. Keep it disabled until the
# privacy notice, recipient evidence, sender domain, and controlled acceptance pack are approved.
OUTREACH_ENABLED=false
OUTREACH_MAX_RECIPIENTS=5
OUTREACH_CANDIDATE_RETENTION_DAYS=30

# Retained for the planned later SES switch; unused while AGENT_MAIL_PROVIDER=resend.
AGENT_MAIL_AWS_REGION=eu-south-1
AGENT_MAIL_INBOUND_SECRET=
# Dedicated IAM credentials limited to SES sending.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=10485760
CONVERSATION_RETENTION_DAYS=365
PRIVACY_NOTICE_VERSION=2026-08-27.1
