# Copy to /opt/laggente/secrets/application.env on the server.
# This file is injected only into the API container.
# Keep the destination owned by root:laggente with mode 0640.

APP_ENV=production
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BASE_DOMAIN=laggente.com
APP_ORIGIN=https://app.laggente.com
CORS_ORIGINS=https://app.laggente.com
TRUSTED_HOSTS=laggente.com,*.laggente.com
COOKIE_SECURE=true
SESSION_TTL_SECONDS=1209600
MAGIC_LINK_TTL_SECONDS=900

# Keep pilot_password until transactional email is configured and tested.
AUTH_MODE=pilot_password
PILOT_EMAIL=REPLACE_WITH_MAURO_EMAIL
PILOT_PASSWORD=REPLACE_WITH_AT_LEAST_14_RANDOM_CHARACTERS
PILOT_NAME=Mauro Rossi
SEED_DEMO=true
AUTO_CREATE_SCHEMA=false

OPENAI_API_KEY=REPLACE_WITH_PROJECT_KEY
OPENAI_MODEL=gpt-5.6
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_MAX_TURNS=6

# Required only when AUTH_MODE=magic_link.
RESEND_API_KEY=
FROM_EMAIL=

UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=10485760
CONVERSATION_RETENTION_DAYS=365
PRIVACY_NOTICE_VERSION=2026-08-22.2
