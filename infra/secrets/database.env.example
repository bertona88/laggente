# Copy to /opt/laggente/secrets/database.env on the server.
# This file is injected only into PostgreSQL, migrations, API, and backup.
# Keep the destination owned by root:laggente with mode 0640.

POSTGRES_USER=laggente
POSTGRES_DB=laggente
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_VALUE
DATABASE_URL=postgresql+psycopg://laggente:REPLACE_WITH_SAME_URL_SAFE_RANDOM_VALUE@db:5432/laggente
